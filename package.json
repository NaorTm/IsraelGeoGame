{
  "name": "israel-geo-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run src/hooks/useGame.test.tsx src/lib/gameSession.test.ts src/utils/districts.test.ts src/utils/settlementBoundaries.test.ts",
    "test:all:local": "npm run test && npm run test:runtime && npm run test:e2e",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview",
    "audit:alerts-map": "node scripts/audit-alerts-map.mjs",
    "report:unmatched-placemarks": "node scripts/report-unmatched-placemarks.mjs",
    "report:inhabited-unmatched": "node scripts/report-inhabited-unmatched-review.mjs",
    "supabase:start:local": "supabase start -x logflare,vector --ignore-health-check",
    "supabase:reset:local": "supabase db reset --local",
    "supabase:stop:local": "supabase stop",
    "localities:build": "node scripts/generate-localities.mjs",
    "supabase:seed": "node scripts/generate-supabase-seed.mjs",
    "boundaries:generate-kml-supplement": "node scripts/generate-kml-supplement.mjs",
    "districts:generate-lookup": "node scripts/generate-settlement-district-lookup.mjs",
    "settlements:generate-regions": "node scripts/generate-settlement-region-catalog.mjs",
    "boundaries:generate-district-loaders": "node scripts/generate-district-boundary-loaders.mjs && node scripts/generate-boundary-load-metadata.mjs",
    "boundaries:generate-load-metadata": "node scripts/generate-boundary-load-metadata.mjs",
    "boundaries:fetch": "node scripts/fetch-settlement-boundaries.mjs",
    "boundaries:split": "node scripts/split-settlement-boundaries.mjs",
    "boundaries:batch": "node scripts/fetch-boundaries-in-batches.mjs",
    "boundaries:build": "npm run boundaries:fetch && npm run boundaries:split"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@turf/simplify": "^7.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "proj4": "^2.20.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
